---
import '@fontsource/albert-sans/latin-400.css';
import '@fontsource/albert-sans/latin-500.css';
import '@fontsource/albert-sans/latin-600.css';
import '@fontsource/albert-sans/latin-700.css';
import '../styles/global.css';
import type { Dict } from '../i18n/types';
import { EMAIL, SITE_URL, WA_DISPLAY, WA_NUMBER } from '../i18n/site';

interface Props {
  dict: Dict;
  title?: string;
  description?: string;
  /** Leave out for pages without a translation (404, privacy). */
  alternates?: boolean;
  noindex?: boolean;
  schema?: boolean;
}

const { dict, title = dict.meta.title, description = dict.meta.description, alternates = true, noindex = false, schema = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL('/og.png', SITE_URL).href;

const jsonLd = schema
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'ProfessionalService',
        '@id': `${SITE_URL}/#organization`,
        name: 'Asemka',
        url: SITE_URL,
        logo: `${SITE_URL}/images/logo.png`,
        image: ogImage,
        description: dict.meta.description,
        email: EMAIL,
        telephone: `+${WA_NUMBER}`,
        address: { '@type': 'PostalAddress', addressLocality: 'Jakarta', addressCountry: 'ID' },
        areaServed: { '@type': 'Country', name: 'Indonesia' },
        availableLanguage: ['en', 'id'],
        openingHoursSpecification: {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '08:00',
          closes: '17:00',
        },
        contactPoint: { '@type': 'ContactPoint', telephone: WA_DISPLAY, contactType: 'sales', availableLanguage: ['English', 'Indonesian'] },
        knowsAbout: dict.services.items.map((s) => s.name),
      },
      {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        inLanguage: dict.lang,
        mainEntity: dict.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      },
    ]
  : null;
---

<!doctype html>
<html lang={dict.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="en" href={`${SITE_URL}/`} />
          <link rel="alternate" hreflang="id" href={`${SITE_URL}/id/`} />
          <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/`} />
        </>
      )
    }
    <meta name="theme-color" content="#f4f4f2" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Asemka" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={dict.lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:locale:alternate" content={dict.lang === 'id' ? 'en_US' : 'id_ID'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
