---
import type { Dict } from '../i18n/types';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const [main, ...rest] = dict.testimonial.items;
---

<!-- Placeholder testimonials: replace with real client quotes before launch. -->
<section class="quotes field-ember frame" aria-labelledby="quotes-title">
  <div class="grid" data-stagger>
    <h2 id="quotes-title" data-reveal>{dict.testimonial.heading}</h2>
    <figure class="main" data-reveal>
      <span class="mark" aria-hidden="true">“</span>
      <blockquote><p>{main.quote}</p></blockquote>
      <figcaption>
        <b>{main.name}</b>
        <span>{main.role}, {main.company}</span>
      </figcaption>
    </figure>
    <div class="side">
      {
        rest.map((q) => (
          <figure data-reveal>
            <blockquote>
              <p>“{q.quote}”</p>
            </blockquote>
            <figcaption>
              <b>{q.name}</b>
              <span>
                {q.role}, {q.company}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .quotes {
    padding-block: var(--section-gap);
  }

  .grid {
    row-gap: 48px;
    align-items: start;
  }

  /* the heading is a label for the section; the client's words carry it */
  h2 {
    grid-column: 1 / -1;
    font-size: var(--step-lead);
    letter-spacing: -0.02em;
  }

  .main {
    grid-column: 1 / 9;
  }

  .mark {
    display: block;
    height: 0.5em;
    margin-bottom: 8px;
    color: var(--ink);
    font-size: clamp(6rem, 4rem + 4vw, 9rem);
    font-weight: 600;
    line-height: 0.9;
  }

  .main blockquote {
    font-size: clamp(1.5rem, 1rem + 1vw, 1.875rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .main blockquote p {
    max-width: 48ch;
  }

  .side {
    grid-column: 9 / 13;
    display: grid;
    gap: 56px;
    padding-top: clamp(40px, 4vw, 72px);
  }

  .side blockquote {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  .side blockquote p {
    max-width: 32ch;
  }

  figcaption {
    display: grid;
    gap: 2px;
    margin-top: 24px;
  }

  figcaption b {
    font-size: var(--step-body);
    font-weight: 700;
  }

  figcaption span {
    font-size: 1rem;
  }

  .main figcaption {
    margin-top: 32px;
  }

  @media (max-width: 899px) {
    .main,
    .side {
      grid-column: 1 / -1;
    }

    .side {
      padding-top: 0;
      gap: 40px;
    }

    .main blockquote {
      font-size: 1.25rem;
    }

    .main blockquote p,
    .side blockquote p {
      max-width: none;
    }
  }
</style>
