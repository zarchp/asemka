---
import type { Dict } from '../i18n/types';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
---

<section id="faq" class="faq field-grey frame" aria-labelledby="faq-title">
  <div class="grid">
    <h2 id="faq-title" data-reveal>{dict.faq.heading}</h2>
    <div class="list" data-stagger>
      {
        dict.faq.items.map((f) => (
          <details data-reveal>
            <summary>
              <span>{f.q}</span>
              <i aria-hidden="true" />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--section-gap);
  }

  .grid {
    align-items: start;
  }

  h2 {
    grid-column: 1 / 5;
    position: sticky;
    top: calc(var(--nav-h) + 40px);
    font-size: var(--step-display);
  }

  .list {
    grid-column: 5 / 13;
    display: grid;
    gap: 8px;
  }

  details {
    background: #2f2f2f;
    transition: background-color var(--t-ui) var(--ease-out);
  }

  details[open] {
    background: var(--paper);
    color: var(--ink);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 72px;
    padding: 14px 16px 14px 24px;
    font-size: var(--step-body);
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline-offset: -3px;
  }

  /* a plus drawn from two bars; the vertical bar turns flat when open */
  /* the plus sits in a circle so it reads as a control; it turns to a minus when open */
  i {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    transition: background-color var(--t-ui) var(--ease-out);
  }

  details[open] i {
    background: var(--ink);
    color: var(--paper);
  }

  i::before,
  i::after {
    content: '';
    position: absolute;
    left: 11px;
    top: calc(50% - 1.5px);
    width: 14px;
    height: 3px;
    background: currentColor;
    transition: transform var(--t-ui) var(--ease-out);
  }

  i::after {
    transform: rotate(90deg);
  }

  details[open] i::after {
    transform: rotate(0deg);
  }

  details p {
    max-width: 52ch;
    padding: 0 24px 24px;
    font-size: var(--step-body);
  }

  @media (hover: hover) and (pointer: fine) {
    details:not([open]):hover {
      background: #262626;
    }

    details:not([open]):hover i {
      background: var(--orange);
      color: #fff;
    }
  }

  @media (max-width: 899px) {
    h2,
    .list {
      grid-column: 1 / -1;
    }

    h2 {
      position: static;
      margin-bottom: 32px;
      font-size: clamp(1.875rem, 9vw, 3rem);
    }

    .list {
      gap: 6px;
    }

    summary {
      min-height: 64px;
      padding: 16px 20px;
      font-size: var(--step-body);
    }

    details p {
      padding: 0 20px 20px;
      font-size: 1rem;
    }
  }
</style>
