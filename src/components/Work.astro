---
import type { Dict } from '../i18n/types';
import { waLink } from '../i18n/site';
import Approval from './screens/Approval.astro';
import PickList from './screens/PickList.astro';
import Catalog from './screens/Catalog.astro';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const fields = { procurement: 'field-orange', warehouse: 'field-grey', wholesale: 'field-paper' } as const;
---

<section id="work" class="work field-ink" aria-labelledby="work-title">
  <h2 id="work-title" class="frame" data-reveal>{dict.work.heading}</h2>

  {
    dict.work.projects.map((p, i) => (
      <article class={`band band-${p.id} ${fields[p.id]}`} style={`--n:${i}`} aria-labelledby={`p-${p.id}`}>
        <div class="tab-row frame">
          <h3 id={`p-${p.id}`} class="tab">
            {p.name}
          </h3>
        </div>
        <div class="body frame">
          <p class="category">{p.category}</p>
          <div class="content grid" data-stagger>
            <figure class="demo" data-reveal>
              <div class="shot">
                {p.id === 'procurement' && <Approval />}
                {p.id === 'warehouse' && <PickList />}
                {p.id === 'wholesale' && <Catalog />}
              </div>
              <figcaption>{p.hint}</figcaption>
            </figure>
            <div class="text" data-reveal>
              <p>{p.body}</p>
              <a class="link more" href={waLink(p.message)} rel="noopener" target="_blank">
                {p.link}
                <svg viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="M221.66 133.66l-72 72a8 8 0 0 1-11.32-11.32L196.69 136H40a8 8 0 0 1 0-16h156.69l-58.35-58.34a8 8 0 0 1 11.32-11.32l72 72a8 8 0 0 1 0 11.32Z" /></svg>
              </a>
            </div>
          </div>
        </div>
      </article>
    ))
  }
</section>

<style>
  .work {
    padding-top: var(--section-gap);
  }

  h2 {
    margin-bottom: 64px;
    font-size: var(--step-display);
  }

  /* folders: each band sticks a little lower than the last, so the tabs pile up */
  .band {
    --tab-h: 56px;
    --strip: 48px;
    --slot: min(420px, (100vw - 2 * var(--m) - 12px) / 3);
    --tab-x: calc(var(--n) * (var(--slot) + 6px));
    position: sticky;
    top: calc(var(--nav-h) + var(--n) * (var(--tab-h) + var(--strip)));
    background: transparent;
    color: var(--fg);
  }

  .tab-row {
    height: var(--tab-h);
    display: flex;
    align-items: flex-end;
  }

  /* every tab has its own slot, a third of the frame, so the pile never covers a name */
  .tab {
    display: flex;
    align-items: center;
    width: var(--slot);
    height: var(--tab-h);
    padding: 0 48px 0 24px;
    margin-left: var(--tab-x);
    background: var(--ground);
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
    clip-path: polygon(0 0, calc(100% - 32px) 0, 100% 100%, 0 100%);
  }

  @media (max-width: 1279px) {
    .tab {
      font-size: 1.1875rem;
      padding-left: 16px;
    }
  }

  .body {
    padding-bottom: clamp(64px, 7vw, 112px);
    background: var(--ground);
  }

  /* the category sits under its own tab, so name and kind read as one label */
  .category {
    height: var(--strip);
    display: flex;
    align-items: center;
    padding-left: calc(var(--tab-x) + 24px);
    font-size: var(--step-small);
    font-weight: 600;
  }

  .content {
    align-items: stretch;
    padding-top: 24px;
  }

  /* screens alternate sides; all share one size, one crop and one corner */
  .demo {
    grid-column: 1 / 9;
    grid-row: 1;
  }

  .band-warehouse .demo {
    grid-column: 5 / 13;
  }

  .band-wholesale {
    --ground: var(--paper-step);
  }

  .shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 10px;
    background: #fff;
  }

  figcaption {
    margin-top: 12px;
    font-size: var(--step-small);
    font-weight: 500;
  }

  /* screens keep their true size; a narrow frame crops them instead of squeezing them */
  .shot :global([data-ui]) {
    min-width: 760px;
  }

  /* the text runs the height of its screen: description at the top, the action level with the screen's foot */
  .text {
    grid-column: 9 / 13;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    padding: 8px 0 36px 24px;
  }

  .band-warehouse .text {
    grid-column: 1 / 5;
    padding: 8px 24px 36px 0;
  }

  .text p {
    max-width: 40ch;
  }

  /* bright orange band: white text is set bold at 19px or more, the large-text level where 3.6:1 is enough */
  .band-procurement .text p,
  .band-procurement .category,
  .band-procurement figcaption,
  .band-procurement .more {
    font-size: 1.1875rem;
    font-weight: 700;
  }

  .band-procurement .tab {
    font-weight: 700;
  }

  .more svg {
    width: 18px;
    height: 18px;
    transition: transform var(--t-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .more:hover svg {
      transform: translateX(4px);
    }
  }

  .more {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding: 8px 0;
    font-weight: 600;
  }

  @media (max-width: 899px) {
    .band {
      position: relative;
      top: auto;
    }

    .band {
      --tab-h: 48px;
    }

    .tab {
      width: auto;
      max-width: calc(100% - 24px);
      margin-left: 0;
      font-size: 1.1875rem;
      white-space: normal;
    }

    .body {
      padding-bottom: 64px;
    }

    .category {
      height: auto;
      padding-top: 16px;
      padding-left: 0;
    }

    .content {
      padding-top: 20px;
      row-gap: 24px;
    }

    .demo,
    .text,
    .band-warehouse .demo,
    .band-warehouse .text {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .text,
    .band-warehouse .text {
      padding: 0;
    }

    .more {
      margin-top: 24px;
    }

    /* the demo keeps its true size and scrolls sideways on a phone */
    .shot {
      aspect-ratio: auto;
      height: 460px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
    }
  }
</style>
