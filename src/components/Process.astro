---
import type { Dict } from '../i18n/types';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const [s1, s2, s3] = dict.process.steps;
const id = dict.lang === 'id';
---

<section id="process" class="process field-paper frame" aria-labelledby="process-title">
  <div class="grid board" data-stagger>
    <h2 id="process-title" data-reveal>{dict.process.heading}</h2>

    <div class="tile t1 field-orange" data-reveal>
      <div class="frag msg" data-ui aria-hidden="true">
        <p class="b in">{id ? 'Halo Asemka. Saya sedang mencari sistem gudang dan stok.' : "Hi Asemka. I'm looking for a warehouse and stock system."}</p>
        <p class="b out">{id ? 'Halo Budi, terima kasih. Boleh kami telepon besok jam 10.00?' : 'Hi Budi, thanks. Can we call you tomorrow at 10.00?'}</p>
      </div>
    </div>

    <div class="tile t2 field-grey" data-reveal>
      <div class="frag proto" data-ui aria-hidden="true">
        <p class="p-title">{id ? 'Ajukan permintaan' : 'New purchase request'}</p>
        <p class="p-label">{id ? 'Cabang' : 'Branch'}</p>
        <p class="p-field">Cabang Surabaya</p>
        <p class="p-label">{id ? 'Barang' : 'Item'}</p>
        <p class="p-field">{id ? 'Kursi kantor, 24 unit' : 'Office chairs, 24 units'}</p>
        <p class="p-label">{id ? 'Perkiraan nominal' : 'Estimated amount'}</p>
        <p class="p-field">Rp 18.720.000</p>
        <p class="p-btn">{id ? 'Kirim untuk persetujuan' : 'Send for approval'}</p>
        <p class="p-note">{id ? 'Prototipe, versi 3' : 'Prototype, version 3'}</p>
      </div>
    </div>

    <div class="tile t3 field-ink" data-reveal>
      <div class="frag live" data-ui aria-hidden="true">
        <div class="l-head">
          <img src="/images/icon.png" alt="" width="24" height="24" />
          <span>Asemka Operation</span>
          <span class="l-live">Live</span>
        </div>
        <p class="l-title">{id ? 'Hari ini, Gudang Cikarang' : 'Today, Cikarang warehouse'}</p>
        <div class="l-stats">
          <p><b>142</b>{id ? 'pesanan dikirim' : 'orders shipped'}</p>
          <p><b>18</b>{id ? 'menunggu packing' : 'waiting to pack'}</p>
          <p><b>3</b>{id ? 'stok menipis' : 'low on stock'}</p>
        </div>
        <p class="l-row"><span>SO/88213</span><span>{id ? 'Dikirim 15.42' : 'Shipped 15.42'}</span></p>
        <p class="l-row"><span>SO/88214</span><span>{id ? 'Packing' : 'Packing'}</span></p>
        <p class="l-row"><span>SO/88216</span><span>{id ? 'Diambil' : 'Picking'}</span></p>
      </div>
    </div>

    {
      [s1, s2, s3].map((st, i) => (
        <div class={`step c${i + 1}`} data-reveal>
          <div class="flow" aria-hidden="true">
            <span class="node">{i + 1}</span>
            <span class="time">{st.time}</span>
            {i < 2 && (
              <span class="arrow">
                <svg viewBox="0 0 14 14">
                  <path d="M1 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            )}
          </div>
          <h3>
            <span class="sr-only">{st.time}: </span>
            {st.name}
          </h3>
          <p>{st.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .process {
    padding-block: var(--section-gap);
  }

  .board {
    row-gap: 24px;
    align-items: end;
  }

  h2 {
    grid-column: 1 / 8;
    grid-row: 1;
    align-self: start;
    font-size: var(--step-display);
  }

  .tile {
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 24px;
  }

  .t1 { grid-column: 1 / 4; height: max(30vh, 260px); }
  .t2 { grid-column: 4 / 8; height: max(44vh, 380px); }
  .t3 { grid-column: 8 / 13; height: max(60vh, 520px); }

  .step { grid-row: 2; align-self: start; }
  .c1 { grid-column: 1 / 4; }
  .c2 { grid-column: 4 / 8; }
  .c3 { grid-column: 8 / 13; }

  /* the flow: a numbered node, the time it takes, and an arrow that draws toward the next step */
  .flow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .node {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: var(--step-small);
    font-weight: 600;
  }

  .c1 .node {
    background: var(--orange);
  }

  .time {
    flex: none;
    font-size: var(--step-small);
    font-weight: 600;
  }

  .arrow {
    position: relative;
    flex: 1;
    height: 14px;
    margin-right: calc(-1 * var(--gutter) + 4px);
    color: var(--ink);
  }

  .arrow::before {
    content: '';
    position: absolute;
    left: 0;
    right: 6px;
    top: 6px;
    height: 2.5px;
    border-radius: 2px;
    background: currentColor;
    transform-origin: left;
  }

  .arrow svg {
    position: absolute;
    right: 0;
    top: 0;
    width: 14px;
    height: 14px;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .step .arrow::before {
      transform: scaleX(0);
      transition: transform 900ms var(--ease-expo) 400ms;
    }

    :global(.js) .step .arrow svg {
      opacity: 0;
      transition: opacity 300ms var(--ease-out) 1100ms;
    }

    :global(.js) .step:global(.is-in) .arrow::before {
      transform: none;
    }

    :global(.js) .step:global(.is-in) .arrow svg {
      opacity: 1;
    }
  }

  .step h3 {
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .step p {
    max-width: 36ch;
    margin-top: 4px;
    color: var(--fg);
  }

  /* fragments: one panel per stage, growing from a message to a working system */
  .frag {
    width: 100%;
    color: #161616;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .msg {
    display: grid;
    gap: 8px;
    max-width: 300px;
    min-height: 200px;
    align-content: center;
  }

  .b {
    max-width: 88%;
    padding: 8px 10px;
    border-radius: 10px;
  }

  .b.in {
    justify-self: end;
    background: var(--wa-bubble);
    border-top-right-radius: 0;
  }

  .b.out {
    background: #fff;
    border-top-left-radius: 0;
  }

  .proto {
    max-width: 320px;
    padding: 20px;
    border-radius: 12px;
    background: #fff;
  }

  .p-title {
    margin-bottom: 12px;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .p-label {
    margin-top: 10px;
    color: #555552;
    font-size: 0.8125rem;
  }

  .p-field {
    margin-top: 4px;
    padding: 8px 10px;
    border: 1px solid #d6d6d2; /* taste-skill-ignore: a form field in the prototype fragment */
    border-radius: 6px;
  }

  .p-btn {
    margin-top: 16px;
    padding: 10px;
    border-radius: 6px;
    background: #161616;
    color: #fff;
    text-align: center;
    font-weight: 600;
  }

  .p-note {
    margin-top: 10px;
    color: #555552;
    font-size: 0.8125rem;
    text-align: center;
  }

  .live {
    max-width: 440px;
    padding: 20px;
    border-radius: 12px;
    background: #fff;
  }

  .l-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  .l-head img {
    width: 24px;
    height: 24px;
  }

  .l-live {
    margin-left: auto;
    padding: 2px 8px;
    border-radius: 999px;
    background: #ff3d00;
    font-size: 0.8125rem;
  }

  .l-title {
    margin-top: 16px;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .l-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 12px 0;
  }

  .l-stats p {
    padding: 10px;
    border-radius: 8px;
    background: #f4f4f2;
    color: #555552;
    font-size: 0.8125rem;
  }

  .l-stats b {
    display: block;
    color: #161616;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .l-row {
    display: flex;
    justify-content: space-between;
    padding: 8px 10px;
    border-radius: 6px;
  }

  .l-row:nth-of-type(odd) {
    background: #f4f4f2;
  }

  .l-row span:first-child {
    font-weight: 600;
  }

  @media (max-width: 899px) {
    .board {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      row-gap: 0;
    }

    h2 {
      margin-bottom: 32px;
      font-size: clamp(1.875rem, 8vw, 3rem);
    }

    .tile { height: auto; }
    .t1 { order: 1; min-height: 46vw; }
    .c1 { order: 2; }
    .t2 { order: 3; min-height: 62vw; margin-top: 28px; }
    .c2 { order: 4; }
    .t3 { order: 5; min-height: 78vw; margin-top: 28px; }
    .c3 { order: 6; }

    .step {
      margin-top: 16px;
    }

    .arrow {
      display: none;
    }
  }
</style>
