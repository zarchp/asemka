---
import type { Dict } from '../i18n/types';
import { waLink } from '../i18n/site';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const c = dict.contact;
const hello = dict.lang === 'id' ? 'Halo Asemka. Bisa kita ngobrol soal proyek?' : 'Hi Asemka. Can we talk about a project?';
const [wa, ...others] = c.rows;
---

<section id="contact" class="contact field-green frame" aria-labelledby="contact-title">
  <div class="grid" data-stagger>
    <div class="intro" data-reveal>
      <h2 id="contact-title">{c.heading}</h2>
      <p>{c.lead}</p>
    </div>

    <!-- the next action: WhatsApp, set large, with a solid button -->
    <div class="primary" data-reveal>
      <a class="number" href={wa.href} rel="noopener" target="_blank">
        <span class="sr-only">{wa.label}: </span>{wa.value}
      </a>
      <a class="button open" href={waLink(hello)} rel="noopener" target="_blank">
        {c.greetingAction}
        <svg viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="M221.66 133.66l-72 72a8 8 0 0 1-11.32-11.32L196.69 136H40a8 8 0 0 1 0-16h156.69l-58.35-58.34a8 8 0 0 1 11.32-11.32l72 72a8 8 0 0 1 0 11.32Z" /></svg>
      </a>
    </div>

    <dl class="details" data-reveal>
      {
        others.map((r) => (
          <div>
            <dt>{r.label}</dt>
            <dd>
              {r.href ? (
                <a class="link" href={r.href}>
                  {r.value}
                </a>
              ) : (
                r.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section-gap);
  }

  .grid {
    row-gap: 56px;
    align-items: end;
  }

  .intro {
    grid-column: 1 / 8;
  }

  h2 {
    font-size: var(--step-display);
  }

  .intro p {
    max-width: 36ch;
    margin-top: 24px;
    font-size: var(--step-lead);
    line-height: 1.35;
  }

  .primary {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding: clamp(24px, 3vw, 40px);
    background: var(--step);
  }

  .number {
    font-size: var(--step-display);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    text-decoration: underline;
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.16em;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    transition: text-decoration-color var(--t-hover) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .number:hover {
      text-decoration-color: currentColor;
    }
  }

  .open {
    --btn-bg: var(--paper);
    --btn-fg: var(--ink);
    --btn-hover: #fff;
    min-height: 56px;
    padding: 14px 24px;
    font-size: 1.125rem;
  }

  .open:focus-visible {
    outline-color: var(--paper);
  }

  .details {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px var(--gutter);
  }

  dt {
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--muted);
  }

  dd {
    margin-top: 6px;
    font-size: var(--step-lead);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  dd .link {
    display: inline-block;
    padding: 2px 0;
  }

  @media (max-width: 767px) {
    .intro {
      grid-column: 1 / -1;
    }

    h2 {
      font-size: clamp(1.875rem, 9vw, 3rem);
    }

    .number {
      font-size: 6.4vw;
      white-space: nowrap;
    }

    .open {
      width: 100%;
      justify-content: center;
    }

    .details {
      grid-template-columns: 1fr;
    }
  }
</style>
